# Copy to .env on the box (chmod 600). NEVER commit. Keys 5 & 6 are RESERVED for
# this box so they never collide with the local machine's keys on Etherscan's
# per-key 3 req/s / 100k-per-day limit.
ETHERSCAN_KEY5=
ETHERSCAN_KEY6=
# Assigned range: the v2 genesis gap (28 Apr -> 8 Jun 2026), disjoint from the
# local machine's cohorts 1-6.
CRAWL_FROM_BLOCK=86126978
CRAWL_TO_BLOCK=88079999
CRAWL_PER_KEY=4  # 4 procs/key x 2 keys x 25k = full 200k/day; ~1.2GB under the 2.2GB cap
CRAWL_MAX_CALLS=25000
CRAWL_MIN_INTERVAL=1.4
# Shrink to 1000 or 500 on a low-RAM box: fewer OrderFilled rows buffered per chunk
# before the parquet write (costs a little more getLogs quota, which a bounded
# range with spare per-key quota can afford).
CRAWL_CHUNK_BLOCKS=2000
